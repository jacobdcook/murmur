#!/usr/bin/env python3
"""murmur-tray — system-tray icon for murmurd (Cinnamon / AppIndicator).

Lives in the taskbar tray like a media applet. The label shows the live
state; the menu gives pause/resume, skip, and live voice switching.
"""
import json
import os
import socket

import gi

gi.require_version("Gtk", "3.0")
try:
    gi.require_version("AppIndicator3", "0.1")
    from gi.repository import AppIndicator3 as AppIndicator
except (ValueError, ImportError):
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3 as AppIndicator
from gi.repository import GLib, Gtk  # noqa: E402

SOCK = "/tmp/murmur.sock"
CFG = os.path.expanduser("~/.config/murmur/config.json")
VOICES = ["am_michael", "am_adam", "am_onyx", "am_liam",
          "af_heart", "af_bella", "af_nicole", "af_sarah",
          "bm_george", "bf_emma"]


def talk(payload, want_reply=False):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1.5)
        s.connect(SOCK)
        s.sendall(payload.encode())
        if want_reply:
            s.shutdown(socket.SHUT_WR)
            data = s.recv(4096).decode().strip()
            s.close()
            return data
        s.close()
    except Exception:
        return None


def set_voice(name):
    os.makedirs(os.path.dirname(CFG), exist_ok=True)
    try:
        d = json.load(open(CFG))
    except Exception:
        d = {}
    d["voice"] = name
    json.dump(d, open(CFG, "w"), indent=2)


class Tray:
    def __init__(self):
        self.ind = AppIndicator.Indicator.new(
            "murmur", "audio-input-microphone",
            AppIndicator.IndicatorCategory.APPLICATION_STATUS,
        )
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.ind.set_title("Murmur")

        menu = Gtk.Menu()
        self.item_toggle = Gtk.MenuItem(label="Pause")
        self.item_toggle.connect("activate", lambda *_: talk("__TOGGLE__"))
        menu.append(self.item_toggle)

        item_skip = Gtk.MenuItem(label="Skip")
        item_skip.connect("activate", lambda *_: talk("__STOP__"))
        menu.append(item_skip)

        menu.append(Gtk.SeparatorMenuItem())

        voice_root = Gtk.MenuItem(label="Voice")
        vsub = Gtk.Menu()
        try:
            cur = json.load(open(CFG)).get("voice", "am_michael")
        except Exception:
            cur = "am_michael"
        for v in VOICES:
            it = Gtk.MenuItem(label=("● " if v == cur else "   ") + v)
            it.connect("activate", self._pick_voice, v)
            vsub.append(it)
        voice_root.set_submenu(vsub)
        menu.append(voice_root)
        self.vsub = vsub

        menu.append(Gtk.SeparatorMenuItem())
        item_quit = Gtk.MenuItem(label="Quit tray")
        item_quit.connect("activate", lambda *_: Gtk.main_quit())
        menu.append(item_quit)

        menu.show_all()
        self.ind.set_menu(menu)
        GLib.timeout_add(700, self._poll)

    def _pick_voice(self, _item, name):
        set_voice(name)
        talk(f"#voice={name}\nNow using the {name} voice.")
        for child in self.vsub.get_children():
            txt = child.get_label().strip("● ").strip()
            child.set_label(("● " if txt == name else "   ") + txt)

    def _poll(self):
        reply = talk("__STATUS__", want_reply=True)
        if reply is None:
            self.ind.set_label("○ off", "murmur")
            self.item_toggle.set_label("Pause")
            return True
        try:
            st = json.loads(reply)
        except Exception:
            return True
        state = st.get("state", "idle")
        glyph = {"speaking": "▮▮", "paused": "▶", "idle": "·",
                 "stopped": "○"}.get(state, "·")
        self.ind.set_label(f"{glyph} {state}", "murmur")
        self.item_toggle.set_label("Resume" if state == "paused" else "Pause")
        return True


if __name__ == "__main__":
    Tray()
    Gtk.main()
