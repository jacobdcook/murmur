#!/bin/bash
# murmur — control the local Kokoro TTS daemon (murmurd)
SOCK=/tmp/murmur.sock
LOG="$HOME/.cache/murmurd.log"
CFG="$HOME/.config/murmur/config.json"
SELF_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

send() {  # send raw payload to the daemon socket
    python3 - "$1" <<'EOF'
import socket, sys
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(2)
    s.connect("/tmp/murmur.sock"); s.sendall(sys.argv[1].encode()); s.close()
except Exception:
    sys.exit(1)
EOF
}

cfg_set() {  # cfg_set key value(json)
    python3 - "$1" "$2" <<'EOF'
import json, os, sys
p = os.path.expanduser("~/.config/murmur/config.json")
os.makedirs(os.path.dirname(p), exist_ok=True)
try:
    d = json.load(open(p))
except Exception:
    d = {}
k, v = sys.argv[1], sys.argv[2]
try:
    v = json.loads(v)
except Exception:
    pass
d[k] = v
json.dump(d, open(p, "w"), indent=2)
print(f"{k} = {v}")
EOF
}

case "$1" in
    on)
        if pgrep -f '/murmurd$' >/dev/null; then
            echo "murmur already running"
        else
            nohup "$SELF_DIR/murmurd" >"$LOG" 2>&1 &
            disown
            echo "murmur starting (log: $LOG)"
        fi
        ;;
    off)      pkill -f '/murmurd$' && echo "murmur off" || echo "not running" ;;
    say)      shift; send "$*" ;;
    pause)    send "__PAUSE__" ;;
    resume)   send "__RESUME__" ;;
    toggle)   send "__TOGGLE__" ;;
    hush|stop|skip) send "__STOP__" ;;
    status)
        if pgrep -f '/murmurd$' >/dev/null; then
            python3 -c "import socket;s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.settimeout(2);s.connect('$SOCK');s.sendall(b'__STATUS__');s.shutdown(socket.SHUT_WR);print(s.recv(4096).decode().strip());s.close()"
        else echo '{"state":"stopped"}'; fi
        ;;
    clips)    python3 -c "import socket,json;s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.settimeout(2);s.connect('$SOCK');s.sendall(b'__CLIPS__');s.shutdown(socket.SHUT_WR);print('\n\n'.join(json.loads(s.recv(65536).decode())));s.close()" ;;
    clips-copy)
        python3 -c "import socket,json;s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.settimeout(2);s.connect('$SOCK');s.sendall(b'__CLIPS__');s.shutdown(socket.SHUT_WR);print('\n\n'.join(json.loads(s.recv(65536).decode())),end='');s.close()" | { command -v xclip >/dev/null && xclip -selection clipboard || xsel -b; } && echo "interrupted text copied to clipboard"
        ;;
    clips-clear) send "__CLEAR_CLIPS__"; echo "cleared" ;;
    voice)    shift; cfg_set voice "\"$1\"" ;;
    speed)    shift; cfg_set speed "$1" ;;
    duck)     shift; cfg_set duck "$1" ;;
    voices)
        # speak a sample line in each candidate voice so you can pick one
        shift
        LINE="${*:-This is the Murmur voice. The quick brown fox jumps over the lazy dog.}"
        for v in am_michael am_adam am_onyx am_liam af_heart af_bella af_nicole af_sarah bm_george bf_emma; do
            echo "  sampling: $v"
            send "#voice=$v
$v speaking. $LINE"
            sleep 1
        done
        echo "Pick one, then: murmur voice <name>"
        ;;
    tray)     pkill -f '/murmur-tray$' 2>/dev/null; setsid "$SELF_DIR/murmur-tray" >>"$LOG" 2>&1 < /dev/null & echo "tray launched" ;;
    bar)      pkill -f '/murmur-bar$' 2>/dev/null; setsid "$SELF_DIR/murmur-bar" >>"$LOG" 2>&1 < /dev/null & echo "bar launched" ;;
    hold)     pkill -f '/murmur-hold$' 2>/dev/null; setsid "$SELF_DIR/murmur-hold" >>"$LOG" 2>&1 < /dev/null & echo "hold listener started (hold Ctrl+I to pause)" ;;
    hotkey-install)
        # remove any old Ctrl+Alt+Space tap binding, start the hold listener
        python3 - <<'EOF'
import subprocess, ast
G = "org.cinnamon.desktop.keybindings"
try:
    lst = ast.literal_eval(subprocess.check_output(["gsettings","get",G,"custom-list"]).decode().strip())
    if "murmur-toggle" in lst:
        lst = [x for x in lst if x != "murmur-toggle"]
        subprocess.run(["gsettings","set",G,"custom-list",str(lst)])
        print("removed old Ctrl+Alt+Space tap binding")
except Exception:
    pass
EOF
        pkill -f '/murmur-hold$' 2>/dev/null
        setsid "$SELF_DIR/murmur-hold" >>"$LOG" 2>&1 < /dev/null &
        echo "hold-to-pause active: hold Ctrl+I to pause, release to resume"
        ;;
    *)
        cat <<EOF
usage: murmur <command>

  on | off            start / stop the daemon (voice on/off)
  say <text>          speak text
  pause | resume      pause / resume playback
  toggle              toggle pause (used by the hotkey + bar)
  hush | skip         stop current + clear the queue (captures spoken text)
  clips               print interrupted text captured so far
  clips-copy          copy interrupted text to the clipboard
  clips-clear         clear the interrupted-text buffer
  status              JSON state
  voice <name>        set default voice (persists)
  speed <x>           set speed, e.g. 1.10
  duck <pct>          music volume while speaking, e.g. 25
  voices [line]       sample every candidate voice out loud
  tray                launch the taskbar tray icon (recommended)
  bar                 launch the always-on-top mini bar (alternative)
  hold                start the hold-to-pause listener (hold Ctrl+I)
  hotkey-install      remove old tap binding + start hold-to-pause
EOF
        ;;
esac
