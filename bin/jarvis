#!/bin/bash
# jarvis — control the Kokoro TTS daemon (jarvisd)
SOCK=/tmp/jarvis.sock
LOG=~/.cache/jarvisd.log

send() {
    python3 - "$1" <<'EOF'
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(2)
s.connect("/tmp/jarvis.sock")
s.sendall(sys.argv[1].encode())
s.close()
EOF
}

case "$1" in
    on)
        if pgrep -f '/jarvisd$' >/dev/null; then
            echo "jarvis already running"
        else
            nohup "$HOME/.local/bin/jarvisd" >"$LOG" 2>&1 &
            disown
            echo "jarvis starting (log: $LOG)"
        fi
        ;;
    off)
        pkill -f '/jarvisd$' && echo "jarvis off" || echo "not running"
        ;;
    say)
        shift
        send "$*"
        ;;
    hush)
        send "__STOP__"
        ;;
    status)
        pgrep -f '/jarvisd$' >/dev/null && echo "running" || echo "stopped"
        ;;
    *)
        echo "usage: jarvis {on|off|say <text>|hush|status}"
        ;;
esac
