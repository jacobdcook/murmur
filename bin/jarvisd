#!/usr/bin/env python3
"""jarvisd — Kokoro TTS daemon. Loads the model once, listens on a unix
socket for text, speaks it on the default audio device.

Protocol: connect to /tmp/jarvis.sock, send UTF-8 text, close.
Special payloads: "__STOP__" clears the queue and stops playback.
"""
import os
import queue
import socket
import sys
import threading

SOCK = "/tmp/jarvis.sock"
VOICE = os.environ.get("JARVIS_VOICE", "am_michael")
SPEED = float(os.environ.get("JARVIS_SPEED", "1.10"))
SAMPLE_RATE = 24_000
MAX_CHARS = 3000

print("jarvisd: loading Kokoro…", flush=True)
from kokoro import KPipeline
import numpy as np
import sounddevice as sd

pipe = KPipeline(lang_code="a")
q = queue.Queue()

def player():
    while True:
        text = q.get()
        try:
            chunks = [a for _, _, a in pipe(text, voice=VOICE, speed=SPEED)]
            if chunks:
                sd.play(np.concatenate(chunks), samplerate=SAMPLE_RATE)
                sd.wait()
        except Exception as e:
            print(f"jarvisd: playback error: {e}", flush=True)

threading.Thread(target=player, daemon=True).start()

if os.path.exists(SOCK):
    os.remove(SOCK)
srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
srv.bind(SOCK)
os.chmod(SOCK, 0o600)
srv.listen(8)
print("jarvisd: ready", flush=True)

while True:
    conn, _ = srv.accept()
    data = b""
    while True:
        buf = conn.recv(65536)
        if not buf:
            break
        data += buf
    conn.close()
    text = data.decode("utf-8", "ignore").strip()
    if not text:
        continue
    if text == "__STOP__":
        try:
            while True:
                q.get_nowait()
        except queue.Empty:
            pass
        sd.stop()
        continue
    q.put(text[:MAX_CHARS])
