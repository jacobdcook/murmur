#!/usr/bin/env python3
"""murmurd — local Kokoro TTS daemon.

Loads the Kokoro model once and speaks any text sent to its unix socket.
Features:
  - streaming playback: speaks each sentence/segment as soon as it is
    synthesized, so the first audio starts in ~1s even for long replies.
  - real pause / resume (not just stop) via a callback-driven OutputStream.
  - music ducking: lowers every other PulseAudio stream while speaking and
    restores it when idle.
  - runtime config from ~/.config/murmur/config.json (voice, speed, duck).

Socket protocol (connect, send UTF-8, close):
  plain text            -> speak it (with the default voice)
  "#voice=NAME\\n<text>"  -> speak <text> with a specific voice (one-off)
  __PAUSE__ / __RESUME__ / __TOGGLE__   -> pause control
  __STOP__              -> skip current utterance + clear the queue
  __STATUS__            -> daemon writes back one JSON line, then closes
"""
import faulthandler
import json
import os
import queue
import signal
import re
import socket
import subprocess
import tempfile
import threading
import time

SOCK = "/tmp/murmur.sock"
CONFIG = os.path.expanduser("~/.config/murmur/config.json")
SAMPLE_RATE = 24_000
MAX_CHARS = 6000

DEFAULTS = {"voice": "am_michael", "speed": 1.10, "duck": 25}

faulthandler.register(signal.SIGUSR1)  # kill -USR1 <pid> dumps all thread stacks


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG) as f:
            cfg.update(json.load(f))
    except Exception:
        pass
    return cfg


def _sentences(text):
    """Split into sentence-ish chunks for streaming + accurate capture."""
    parts = re.split(r"(?<=[.!?:])\s+|\n+", text)
    return [p.strip() for p in parts if p.strip()]


def _force_full_volume():
    """Our own playback must not stay stuck at a low volume that PulseAudio's
    stream-restore remembered from a previous ducking. Unmute + set 100%."""
    import time as _t
    for _ in range(12):
        try:
            raw = subprocess.run(
                ["pactl", "list", "sink-inputs"],
                capture_output=True, text=True, timeout=2,
            ).stdout
        except Exception:
            return
        sid = None
        for line in raw.splitlines():
            m = re.match(r"Sink Input #(\d+)", line)
            if m:
                sid = m.group(1)
            elif 'application.name = "Murmur"' in line and sid:
                subprocess.run(["pactl", "set-sink-input-mute", sid, "0"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["pactl", "set-sink-input-volume", sid, "100%"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
        _t.sleep(0.05)


print("murmurd: loading Kokoro…", flush=True)
# CPU-only: Kokoro-82M is ~3x realtime on CPU, and this avoids stalling on a GPU
# shared with ollama / Whisper (which can wedge synth when VRAM is tight).
os.environ["CUDA_VISIBLE_DEVICES"] = ""
from kokoro import KPipeline
import numpy as np
import soundfile as sf

pipe = KPipeline(lang_code="a")

# Playback goes through `paplay` to the PulseAudio DEFAULT sink, so it always
# follows whatever output the user is on right now (AirPods, open comms, USB,
# onboard) with no device pinning.


# ── music ducking ─────────────────────────────────────────────────────────
class Ducker:
    """Lower every other PulseAudio stream while we speak, restore after."""

    def __init__(self):
        self.saved = {}
        self.pid = str(os.getpid())

    def _sink_inputs(self):
        out = []
        try:
            raw = subprocess.run(
                ["pactl", "list", "sink-inputs"],
                capture_output=True, text=True, timeout=2,
            ).stdout
        except Exception:
            return out
        cur = {}
        for line in raw.splitlines():
            m = re.match(r"Sink Input #(\d+)", line)
            if m:
                if cur:
                    out.append(cur)
                cur = {"id": m.group(1), "pid": None, "vol": None, "app": ""}
            elif "application.process.id" in line:
                mm = re.search(r'"(\d+)"', line)
                if mm:
                    cur["pid"] = mm.group(1)
            elif "application.name" in line:
                mm = re.search(r'= "(.*)"', line)
                if mm:
                    cur["app"] = mm.group(1)
            elif line.strip().startswith("Volume:") and cur.get("vol") is None:
                mm = re.search(r"(\d+)%", line)
                if mm:
                    cur["vol"] = int(mm.group(1))
        if cur:
            out.append(cur)
        return out

    def duck(self, pct):
        for si in self._sink_inputs():
            # never duck our own speech (paplay named "Murmur")
            if si.get("app") == "Murmur":
                continue
            if si["pid"] == self.pid or si["id"] in self.saved:
                continue
            if si["vol"] is None:
                continue
            self.saved[si["id"]] = si["vol"]
            try:
                subprocess.run(
                    ["pactl", "set-sink-input-volume", si["id"], f"{pct}%"],
                    timeout=2,
                )
            except Exception:
                pass

    def restore(self):
        for sid, vol in list(self.saved.items()):
            try:
                subprocess.run(
                    ["pactl", "set-sink-input-volume", sid, f"{vol}%"],
                    timeout=2,
                )
            except Exception:
                pass
        self.saved.clear()


# ── playback engine ───────────────────────────────────────────────────────
class Engine:
    def __init__(self):
        self.q = queue.Queue()
        self.lock = threading.Lock()
        self.paused = False
        self.skip = False
        self.speaking = False
        self.current = ""
        self.spoken = []      # text segments spoken in the current utterance
        self.clips = []       # interrupted text, accumulated across skips
        self.ducker = Ducker()
        threading.Thread(target=self._worker, daemon=True).start()

    # public control
    def enqueue(self, text, voice=None):
        self.q.put((text, voice))

    def pause(self):
        with self.lock:
            self.paused = True

    def resume(self):
        with self.lock:
            self.paused = False

    def toggle(self):
        with self.lock:
            self.paused = not self.paused
            return self.paused

    def stop(self):
        # skip current utterance and drop the whole queue.
        # capture what was spoken so far — if you interrupted, you wanted it.
        try:
            while True:
                self.q.get_nowait()
        except queue.Empty:
            pass
        with self.lock:
            if self.speaking:
                clip = " ".join(self.spoken).strip() or self.current
                if clip:
                    self.clips.append(clip)
            self.skip = True
            self.paused = False

    def get_clips(self):
        with self.lock:
            return list(self.clips)

    def clear_clips(self):
        with self.lock:
            self.clips.clear()

    def status(self):
        with self.lock:
            state = "paused" if self.paused else ("speaking" if self.speaking else "idle")
            return {
                "state": state,
                "queued": self.q.qsize(),
                "text": self.current[:120],
                "clips": len(self.clips),
            }

    # internals
    def _play(self, audio):
        """Play one audio chunk to the default PulseAudio sink via paplay.
        Follows the user's current output device; interruptible by skip."""
        if hasattr(audio, "detach"):  # torch.Tensor -> numpy
            audio = audio.detach().cpu().numpy()
        audio = np.asarray(audio, dtype="float32").reshape(-1)
        path = tempfile.mktemp(suffix=".wav")
        try:
            sf.write(path, audio, SAMPLE_RATE)
            proc = subprocess.Popen(
                ["paplay", "--property=application.name=Murmur", path],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            threading.Thread(target=_force_full_volume, daemon=True).start()
            while proc.poll() is None:
                with self.lock:
                    if self.skip:
                        proc.terminate()
                        break
                time.sleep(0.05)
        except Exception as e:
            print(f"murmurd: play error: {e}", flush=True)
        finally:
            try:
                os.unlink(path)
            except Exception:
                pass

    def _worker(self):
        while True:
            text, voice = self.q.get()
            cfg = load_config()
            voice = voice or cfg["voice"]
            speed = cfg["speed"]
            with self.lock:
                self.skip = False
                self.speaking = True
                self.current = text
                self.spoken = []
            try:
                self.ducker.duck(cfg["duck"])
                for sentence in _sentences(text):
                    # honor pause at each sentence boundary (hold-to-pause)
                    while True:
                        with self.lock:
                            if self.skip or not self.paused:
                                break
                        time.sleep(0.05)
                    with self.lock:
                        if self.skip:
                            break
                        self.spoken.append(sentence)
                    for _, _, audio in pipe(sentence, voice=voice, speed=speed):
                        with self.lock:
                            if self.skip:
                                break
                        if audio is not None and len(audio):
                            self._play(audio)
            except Exception as e:
                print(f"murmurd: playback error: {e}", flush=True)
            finally:
                with self.lock:
                    self.speaking = False
                    self.current = ""
                # only un-duck once nothing else is waiting
                if self.q.empty():
                    self.ducker.restore()


engine = Engine()


# ── socket server ─────────────────────────────────────────────────────────
if os.path.exists(SOCK):
    os.remove(SOCK)
srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
srv.bind(SOCK)
os.chmod(SOCK, 0o600)
srv.listen(16)
print("murmurd: ready", flush=True)

while True:
    conn, _ = srv.accept()
    data = b""
    try:
        while True:
            b = conn.recv(65536)
            if not b:
                break
            data += b
    except Exception:
        conn.close()
        continue
    text = data.decode("utf-8", "ignore").strip()
    if not text:
        conn.close()
        continue

    if text == "__STATUS__":
        try:
            conn.sendall((json.dumps(engine.status()) + "\n").encode())
        except Exception:
            pass
        conn.close()
        continue

    if text == "__CLIPS__":
        try:
            conn.sendall((json.dumps(engine.get_clips()) + "\n").encode())
        except Exception:
            pass
        conn.close()
        continue

    conn.close()

    if text == "__CLEAR_CLIPS__":
        engine.clear_clips()
        continue

    if text == "__PAUSE__":
        engine.pause()
    elif text == "__RESUME__":
        engine.resume()
    elif text == "__TOGGLE__":
        engine.toggle()
    elif text == "__STOP__":
        engine.stop()
    elif text.startswith("#voice="):
        first, _, rest = text.partition("\n")
        engine.enqueue(rest.strip()[:MAX_CHARS], voice=first[len("#voice="):].strip())
    else:
        engine.enqueue(text[:MAX_CHARS])
