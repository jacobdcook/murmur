#!/usr/bin/env python3
"""murmur-hold — global hold-to-pause listener.

Hold Ctrl+I to pause murmurd; release to resume. Uses pynput so it can see
key *release* (which desktop keybindings cannot), giving true push-to-pause.

Note: Ctrl+I is the terminal Tab control code, so holding it while a terminal
is focused also sends tabs. Pause/resume still works regardless of focus.
"""
import os
import socket

from pynput import keyboard

SOCK = "/tmp/murmur.sock"
LOG = os.path.expanduser("~/.cache/murmur-hold.log")

CTRL = {keyboard.Key.ctrl_l, keyboard.Key.ctrl_r}


def send(payload):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1)
        s.connect(SOCK)
        s.sendall(payload.encode())
        s.close()
    except Exception:
        pass


def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write(msg + "\n")
    except Exception:
        pass


def is_i(key):
    ch = getattr(key, "char", None)
    if ch is None:
        return False
    # bare 'i', or Ctrl+I which the terminal encodes as Tab (0x09)
    return ch in ("i", "I", "\t", "\x09")


class Hold:
    def __init__(self):
        self.ctrl = False
        self.i = False
        self.paused = False

    def _eval(self):
        want = self.ctrl and self.i
        if want and not self.paused:
            send("__PAUSE__")
            self.paused = True
            log("pause")
        elif not want and self.paused:
            send("__RESUME__")
            self.paused = False
            log("resume")

    def on_press(self, key):
        if key in CTRL:
            self.ctrl = True
        elif is_i(key):
            self.i = True
        self._eval()

    def on_release(self, key):
        if key in CTRL:
            self.ctrl = False
        elif is_i(key):
            self.i = False
        self._eval()


if __name__ == "__main__":
    log("murmur-hold: listening (Ctrl+I = hold to pause)")
    h = Hold()
    with keyboard.Listener(on_press=h.on_press, on_release=h.on_release) as ll:
        ll.join()
